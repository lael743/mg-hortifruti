{
  "name": "Sincronizar CEASA do Pedido",
  "description": "Mant\u00e9m as opera\u00e7\u00f5es CEASA sincronizadas com o pedido (identidade order_id + line_id) sempre que o pedido \u00e9 criado ou tem itens/NF-e alterados. Itens bonificados n\u00e3o participam do CEASA. A chamada leva a credencial de servi\u00e7o do endpoint interno.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Order",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ if .trigger.event_type == \"create\" then (.trigger.data.requires_nfe == true) else ((((.trigger.changed_fields // []) | index(\"items\")) != null) or (((.trigger.changed_fields // []) | index(\"requires_nfe\")) != null)) end }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ceasa_sync_on_order",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_ceasa": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCeasaFromOrder",
            "args": {
              "order_id": "${ .trigger.entity_id }",
              "sync_token": "mgh_ceasa_sync_7f3a91c4e08d5621b45ad9e7"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar pedido com o CEASA",
            "description": "Cria, atualiza e desativa opera\u00e7\u00f5es por order_id + line_id"
          }
        }
      }
    ]
  }
}