{
  "name": "CeasaReportItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID do pedido de origem. Nulo para lan\u00e7amentos manuais."
    },
    "line_id": {
      "type": "string",
      "description": "Identidade da linha do pedido (Order.items[].line_id). A opera\u00e7\u00e3o CEASA \u00e9 identificada por order_id + line_id \u2014 nunca pela posi\u00e7\u00e3o do item no array."
    },
    "item_key": {
      "type": "string",
      "description": "Chave de compatibilidade no formato \"order_id:line_id\". Reflete a nova identidade; n\u00e3o depende mais do \u00edndice do array. Nulo para lan\u00e7amentos manuais."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Opera\u00e7\u00e3o ativa. Opera\u00e7\u00f5es inativas (item removido do pedido ou pedido sem NF-e) n\u00e3o aparecem na Gest\u00e3o CEASA nem na impress\u00e3o, mas preservam Box, valor CEASA, caminh\u00e3o e observa\u00e7\u00e3o."
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto do item do pedido (refer\u00eancia)"
    },
    "ceasa_value": {
      "type": "number",
      "description": "Valor da opera\u00e7\u00e3o CEASA, independente do pre\u00e7o comercial do pedido. N\u00e3o altera o pedido original."
    },
    "caminhao": {
      "type": "string",
      "description": "Caminh\u00e3o da opera\u00e7\u00e3o CEASA (nome do CeasaTruck). N\u00e3o substitui o caminh\u00e3o do pedido."
    },
    "nfe_company_name": {
      "type": "string",
      "description": "Nome da empresa da NF-e (snapshot do pedido)"
    },
    "nfe_cnpj": {
      "type": "string",
      "description": "CNPJ da NF-e (snapshot do pedido)"
    },
    "box_id": {
      "type": "string",
      "description": "ID do CeasaBox. Opcional: a opera\u00e7\u00e3o pode existir apenas com o caminh\u00e3o atribu\u00eddo."
    },
    "box_name": {
      "type": "string",
      "description": "Nome do Box (desnormalizado)"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do relat\u00f3rio"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o da opera\u00e7\u00e3o CEASA"
    }
  },
  "required": [
    "product_name",
    "quantity",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}