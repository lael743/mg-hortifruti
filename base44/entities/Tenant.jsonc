{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa/tenant"
    },
    "subdomain": {
      "type": "string",
      "description": "Subdom\u00ednio \u00fanico (ex: empresaA para empresaA.horta.com.br)"
    },
    "admin_email": {
      "type": "string",
      "description": "Email do administrador principal do tenant"
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo do tenant"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "default": "active",
      "description": "Status do tenant"
    }
  },
  "required": [
    "name",
    "subdomain",
    "admin_email"
  ]
}