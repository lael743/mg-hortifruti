{
  "name": "CustomPrice",
  "type": "object",
  "properties": {
    "price_group_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7os"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "custom_price": {
      "type": "number",
      "description": "Pre\u00e7o customizado do produto nesta tabela"
    },
    "is_promotion": {
      "type": "boolean",
      "default": false,
      "description": "Promo\u00e7\u00e3o comercial da rela\u00e7\u00e3o PriceGroup + Product. \u00c9 apenas uma flag visual/comercial: n\u00e3o altera o pre\u00e7o resolvido pelo priceEngine. S\u00f3 existe quando h\u00e1 pre\u00e7o definido na tabela."
    }
  },
  "required": [
    "price_group_id",
    "product_id",
    "custom_price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}