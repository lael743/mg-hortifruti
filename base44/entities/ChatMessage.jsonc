{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do tenant"
    },
    "conversation_id": {
      "type": "string",
      "description": "Email do cliente (identificador da conversa)"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "read_by_client": {
      "type": "boolean",
      "default": false
    },
    "read_by_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tenant_id",
    "conversation_id",
    "sender_email",
    "message"
  ]
}