{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "number",
      "description": "N\u00famero do pedido (sequencial e curto)"
    },
    "customer_email": {
      "type": "string",
      "description": "Email do cliente (ou pseudo-email para clientes avulsos)"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "customer_display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o (empresa ou nome, para clientes avulsos)"
    },
    "walk_in_client_id": {
      "type": "string",
      "description": "ID do WalkInClient (para pedidos avulsos sem conta no sistema)"
    },
    "items": {
      "type": "array",
      "description": "Itens do pedido",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "final_unit_price": {
            "type": "number",
            "description": "Pre\u00e7o final efetivo (pode ser editado pelo admin)"
          },
          "packaging_type": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal dos itens antes do desconto"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "value",
        "percent"
      ],
      "description": "Tipo do desconto: valor fixo ou percentual"
    },
    "discount_value": {
      "type": "number",
      "description": "Valor do desconto (em R$ se type=value, ou % se type=percent)",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "description": "Valor monet\u00e1rio do desconto aplicado (sempre em R$)",
      "default": 0
    },
    "total": {
      "type": "number",
      "description": "Valor total do pedido (ap\u00f3s desconto)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Confirmado",
        "Entregue",
        "Cancelado"
      ],
      "default": "Pendente",
      "description": "Status do pedido"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do pedido"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}