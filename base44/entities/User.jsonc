{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "client"
      ],
      "default": "client"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status de aprova\u00e7\u00e3o do cliente"
    },
    "company_name": {
      "type": "string",
      "description": "Nome do estabelecimento / raz\u00e3o social"
    },
    "cnpj_cpf": {
      "type": "string",
      "description": "CNPJ ou CPF do cliente"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp do cliente"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo (rua, n\u00famero, bairro)"
    },
    "city": {
      "type": "string",
      "description": "Cidade"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "price_group_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7os aplicada a este cliente"
    },
    "price_group_name": {
      "type": "string",
      "description": "Nome da tabela de pre\u00e7os (cache para exibi\u00e7\u00e3o)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas do admin sobre o cliente"
    }
  }
}