{
  "name": "User",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do tenant a que o usu\u00e1rio pertence (vazio para super-admin)"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "superadmin"
      ],
      "default": "user",
      "description": "Papel do usu\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status de aprova\u00e7\u00e3o do usu\u00e1rio"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa do usu\u00e1rio"
    },
    "phone": {
      "type": "string"
    },
    "cnpj_cpf": {
      "type": "string"
    },
    "price_group_id": {
      "type": "string",
      "description": "ID do grupo de pre\u00e7o do usu\u00e1rio"
    }
  }
}