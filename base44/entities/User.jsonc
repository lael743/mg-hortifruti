{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "company_name": {
      "type": "string",
      "description": "Nome fantasia ou raz\u00e3o social da empresa"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome da pessoa de contato respons\u00e1vel (para mensagens personalizadas)"
    },
    "cnpj": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "price_group_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7os vinculada ao cliente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas sobre o cliente"
    },
    "last_whatsapp_campaign_date": {
      "type": "string",
      "description": "Data do \u00faltimo envio de campanha WhatsApp"
    }
  },
  "required": [],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}