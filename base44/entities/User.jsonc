{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa do cliente"
    },
    "cnpj": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "price_group_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7os do cliente"
    },
    "last_whatsapp_campaign_date": {
      "type": "string",
      "description": "Data do \u00faltimo envio de mensagem de campanha via WhatsApp"
    }
  }
}