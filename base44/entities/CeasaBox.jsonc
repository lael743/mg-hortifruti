{
  "name": "CeasaBox",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do Box do Ceasa (ex: Box 1, Box 03 Irm\u00e3os)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ do Box"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Box ativo"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "LEGADO/obsoleto: v\u00ednculo de produtos n\u00e3o \u00e9 mais utilizado pela opera\u00e7\u00e3o CEASA. O Box passa a ser definido por item na Gest\u00e3o CEASA. Campo mantido apenas para preservar os dados existentes."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}